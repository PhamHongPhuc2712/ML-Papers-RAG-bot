                "type": "null"
              }
            ],
            "title": "Year"
          }
        },
        "required": [
          "paper_id",
          "rank",
          "read",
          "title"
        ],
        "title": "Reference",
        "type": "object"
      },
      "SearchRequest": {
        "additionalProperties": false,
        "properties": {
          "cursor": {
            "anyOf": [
              {
                "type": "string"
