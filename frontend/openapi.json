      "Reference": {
        "additionalProperties": false,
        "description": "A paper the turn's search ranked: the answer's References (RAG-only plan, U1).\n\n``read`` marks the papers the turn looked inside for evidence, the first of the ranking.\nStored as the id, rank and flag only; title, venue and year are the corpus's own.",
        "properties": {
          "paper_id": {
            "format": "uuid",
            "title": "Paper Id",
            "type": "string"
          },
          "rank": {
            "minimum": 1.0,
            "title": "Rank",
            "type": "integer"
          },
          "read": {
            "title": "Read",
            "type": "boolean"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "venue": {
            "anyOf": [
              {
                "type": "string"
