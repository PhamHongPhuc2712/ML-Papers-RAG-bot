# Development-only defaults. Copy to .env and replace secrets before use.
COPILOT_ENV=development

# Single root for ALL persistent local data (spec §3): Postgres and Qdrant
# bind mounts, uploads, exports, backups, model cache, test-profile state.
# Delete this directory to delete the entire dataset. Written without a
# trailing separator so Compose can append subdirectories; the documented
# spelling C:\ml-copilot-data\ names the same place and Settings accepts it.
DATA_DIR=C:\ml-copilot-data

DATABASE_URL=postgresql+psycopg://copilot:copilot-dev-password@localhost:5432/copilot
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_PREFIX=dev_
MODEL_MODE=real
SECRET_KEY=replace-this-with-a-random-development-secret
READY_TIMEOUT_SECONDS=2
CORS_ORIGINS=http://localhost:3000

# The integration fixture reads these explicitly, requires a test_ namespace,
# and keeps its files under ${DATA_DIR}/test — the directory the Compose test
# profile bind-mounts. Missing values fail the suite; they never skip it.
TEST_DATABASE_URL=postgresql+psycopg://copilot_test:copilot_test_password@localhost:55432/test_copilot
TEST_QDRANT_URL=http://localhost:56333
TEST_QDRANT_COLLECTION_PREFIX=test_

# OpenReview login for the ingestion pilot (free account). Guest API access
# receives a browser challenge (HTTP 403); leave empty to run fixtures only.
OPENREVIEW_USERNAME=
OPENREVIEW_PASSWORD=

# Hugging Face read token for offline corpus capture. Without it the Hub applies
# anonymous rate limits to shard downloads. Never used during a user request.
HF_TOKEN=
