# Development-only defaults. Copy to .env and replace secrets before use.
COPILOT_ENV=development
DATABASE_URL=postgresql+psycopg://copilot:copilot-dev-password@localhost:5432/copilot
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_PREFIX=dev_
MODEL_MODE=real
SECRET_KEY=replace-this-with-a-random-development-secret
READY_TIMEOUT_SECONDS=2
CORS_ORIGINS=http://localhost:3000

# The integration fixture reads these explicitly and requires a test_ namespace.
TEST_DATABASE_URL=postgresql+psycopg://copilot_test:copilot_test_password@localhost:55432/test_copilot
TEST_QDRANT_URL=http://localhost:56333
TEST_QDRANT_COLLECTION_PREFIX=test_
